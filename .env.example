# AI Provider Configuration
AI_PROVIDER=ollama  # Options: ollama, openai, local
AI_MODEL=qwen2.5    # For Ollama
OLLAMA_URL=http://localhost:11434

# OpenAI Configuration (if using OpenAI)
OPENAI_API_KEY=your_key_here
OPENAI_MODEL=gpt-4

# Kdenlive Configuration
KDENLIVE_PATH=C:\Program Files\KDE\bin\kdenlive.exe
KDENLIVE_TIMEOUT=30

# FFmpeg Configuration
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Application Settings
APP_TITLE=AI Video Editor Agent
DEBUG_MODE=false
LOG_LEVEL=INFO

# Video Export Settings
DEFAULT_EXPORT_FORMAT=mp4
DEFAULT_EXPORT_QUALITY=high
DEFAULT_FPS=30
